<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:splitMotionEvents="false"
    style="@style/ShutterGroupPhoto">
    <Button
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:id="@+id/btn_cancel"
        android:background="@null"
        android:layout_width="0dp"
        android:text="@android:string/cancel"
        android:layout_weight="1"
        style="@style/twShutterButtonPhoto"/>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <com.android.camera.p001ui.ShutterButton
            android:id="@+id/shutter_button_video"
            android:src="@drawable/btn_video"
            android:layout_centerInParent="true"
            android:contentDescription="@string/accessibility_video_shutter_button"
            style="@style/twShutterButtonPhoto"/>
    </RelativeLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
</LinearLayout>
