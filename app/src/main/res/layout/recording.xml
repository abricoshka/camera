<?xml version="1.0" encoding="utf-8"?>
<com.android.camera.p001ui.RotateLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/RecordingLayout">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/recording_time_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/recording_time"
                style="@style/RecordingText"/>
            <ImageView
                android:id="@+id/btn_pause_resume"
                android:background="@drawable/bg_pressed"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:src="@drawable/ic_recording_pause"
                android:soundEffectsEnabled="false"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/recording_size_group"
            android:background="@drawable/bg_indicator_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <TextView
                android:id="@+id/recording_current"
                style="@style/RecordingSizeText"/>
            <SeekBar
                android:id="@+id/recording_progress"
                android:focusable="false"
                android:clickable="false"
                android:thumb="@null"
                style="@style/RecordingSizeProgress"/>
            <TextView
                android:id="@+id/recording_total"
                style="@style/RecordingSizeText"/>
        </RelativeLayout>
    </RelativeLayout>
</com.android.camera.p001ui.RotateLayout>
