<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/camera_shutter_bar"
    style="@style/IosShutterGroup">
    <include layout="@layout/ios_root_layout"/>
    <FrameLayout
        android:id="@+id/camera_shutter"
        android:splitMotionEvents="false"
        style="@style/twShutterGroup">
        <com.android.camera.p001ui.ShutterButton
            android:id="@+id/shutter_button_video"
            android:src="@drawable/btn_video"
            android:contentDescription="@string/accessibility_video_shutter_button"
            style="@style/twShutterButton"/>
        <com.android.camera.p001ui.ShutterButton
            android:id="@+id/shutter_button"
            android:src="@drawable/btn_photo"
            android:contentDescription="@string/accessibility_shutter_button"
            style="@style/twShutterButton"/>
    </FrameLayout>
</FrameLayout>
