<?xml version="1.0" encoding="utf-8"?>
<com.android.camera.p002v2.p003ui.SettingVirtualLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:camera="http://schemas.android.com/apk/res/com.mediatek.camera"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false"
    style="@style/ScreenOnMargin">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:splitMotionEvents="false">
        <com.android.camera.p002v2.p003ui.MaxLinearLayout
            android:id="@+id/container"
            camera:maxHeight="@dimen/setting_container2_height_max"
            style="@style/SettingContainer2">
            <ListView
                android:id="@+id/settingList"
                style="@style/SettingItemList"/>
        </com.android.camera.p002v2.p003ui.MaxLinearLayout>
    </RelativeLayout>
</com.android.camera.p002v2.p003ui.SettingVirtualLayout>
