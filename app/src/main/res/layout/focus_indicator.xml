<?xml version="1.0" encoding="utf-8"?>
<com.android.camera.p001ui.FocusIndicatorRotateLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_indicator_rotate_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true">
    <TextView
        android:gravity="center"
        android:id="@+id/distance_info"
        android:layout_width="80dp"
        android:layout_height="80dp"/>
    <View
        android:id="@+id/focus_indicator"
        android:layout_width="80dp"
        android:layout_height="80dp"/>
</com.android.camera.p001ui.FocusIndicatorRotateLayout>
