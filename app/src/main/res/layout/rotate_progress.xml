<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:camera="http://schemas.android.com/apk/res/com.mediatek.camera"
    android:gravity="center"
    android:id="@+id/rotate_dialog_root_layout"
    android:background="#99000000"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.camera.p001ui.RotateLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/rotate_dialog_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.android.camera.p001ui.MaxLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            camera:maxWidth="@dimen/onscreen_hint_max_width">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/rotate_dialog_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textColor="@color/setting_item_text_color_normal"
                android:layout_gravity="center_vertical"
                android:id="@+id/rotate_dialog_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@android:style/TextAppearance.Holo.Medium"/>
        </com.android.camera.p001ui.MaxLinearLayout>
    </com.android.camera.p001ui.RotateLayout>
</FrameLayout>
