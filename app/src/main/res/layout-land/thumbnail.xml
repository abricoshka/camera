<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/ReviewThumbnailGroup">
    <com.android.camera.p001ui.RotateImageView
        android:id="@+id/thumbnail"
        android:background="@drawable/border_last_picture"
        android:focusable="false"
        android:clickable="true"
        android:layout_toRightOf="@+id/preview_thumb"
        android:contentDescription="@string/accessibility_review_thumbnail"
        style="@style/ReviewThumbnail"/>
    <com.android.camera.p001ui.RotateImageView
        android:id="@+id/preview_thumb"
        android:visibility="invisible"
        style="@style/ReviewThumbnail"/>
</RelativeLayout>
