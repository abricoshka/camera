<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:height="60dp"
    android:width="60dp">
    <item>
        <shape
            android:dither="true"
            android:shape="oval">
            <solid android:color="#f5f5f5"/>
            <stroke
                android:width="9dp"
                android:color="#88f5f5f5"/>
        </shape>
    </item>
    <item
        android:left="23.5dp"
        android:top="23.5dp"
        android:right="23.5dp"
        android:bottom="23.5dp">
        <shape
            android:dither="true"
            android:shape="rectangle">
            <solid android:color="#000000"/>
            <corners android:radius="2.5dp"/>
        </shape>
    </item>
</layer-list>
