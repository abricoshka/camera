<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:height="60dp"
    android:width="60dp">
    <item>
        <shape
            android:dither="true"
            android:shape="oval">
            <solid android:color="#f5f5f5"/>
            <stroke
                android:width="9dp"
                android:color="#88f5f5f5"/>
        </shape>
    </item>
    <item>
        <shape
            android:dither="true"
            android:shape="oval">
            <solid android:color="#ff0000"/>
            <stroke
                android:width="48dp"
                android:color="#00000000"/>
        </shape>
    </item>
</layer-list>
