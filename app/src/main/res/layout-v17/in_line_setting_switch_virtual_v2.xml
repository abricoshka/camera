<?xml version="1.0" encoding="utf-8"?>
<com.android.camera.p002v2.p003ui.InLineSettingSwitchVirtual xmlns:android="http://schemas.android.com/apk/res/android" style="@style/CameraSettingRow">
    <TextView
        android:id="@+id/title"
        android:layout_toStartOf="@+id/virtual_switch"
        android:layout_alignParentStart="true"
        style="@style/CameraSettingItemTitle"/>
    <Switch
        android:textColor="@color/setting_item_text_color_normal_text"
        android:gravity="end|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/virtual_switch"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/camera_setting_item_list_margin"
        android:layout_alignParentEnd="true"/>
</com.android.camera.p002v2.p003ui.InLineSettingSwitchVirtual>
