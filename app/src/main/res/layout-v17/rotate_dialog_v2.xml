<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/rotate_dialog_root_layout"
    android:background="#aa000000"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.camera.p002v2.p003ui.RotateLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/rotate_dialog_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="#ff282828"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rotate_dialog_title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/rotate_dialog_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:maxLines="2"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    style="@android:style/TextAppearance.Holo.DialogWindowTitle"/>
                <View
                    android:id="@+id/rotate_dialog_title_divider"
                    style="@style/PopupTitleSeparator"/>
            </LinearLayout>
            <ImageView
                android:background="@drawable/list_divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@color/popup_background"
                android:padding="9dp"
                android:layout_width="280dp"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/setting_item_text_color_normal"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/rotate_dialog_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@android:style/TextAppearance.Holo.Medium"/>
            </LinearLayout>
            <ImageView
                android:background="@drawable/list_divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/rotate_dialog_button_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/list_divider"
                android:minHeight="48dp"
                android:showDividers="middle"
                android:dividerPadding="0dp">
                <Button
                    android:textSize="14sp"
                    android:gravity="center"
                    android:id="@+id/rotate_dialog_button1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:maxLines="2"
                    android:layout_weight="1"
                    style="@android:style/Widget.Holo.Button.Borderless"/>
                <Button
                    android:textSize="14sp"
                    android:gravity="center"
                    android:id="@+id/rotate_dialog_button2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:maxLines="2"
                    android:layout_weight="1"
                    style="@android:style/Widget.Holo.Button.Borderless"/>
            </LinearLayout>
        </LinearLayout>
    </com.android.camera.p002v2.p003ui.RotateLayout>
</FrameLayout>
