<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CameraSettingItemTitle" parent="">
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:textColor">@color/tw_setting_item_text_color_normal</item>
        <item name="android:ellipsize">4</item>
        <item name="android:gravity">0x800013</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:singleLine">true</item>
        <item name="android:textDirection">5</item>
        <item name="android:layout_marginStart">@dimen/camera_setting_item_list_margin</item>
    </style>
    <style name="SettingItemSubTitle" parent="">
        <item name="android:textAppearance">?android:attr/textAppearance</item>
        <item name="android:textColor">@color/tw_setting_item_text_color_normal</item>
        <item name="android:ellipsize">4</item>
        <item name="android:gravity">0x800013</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">@dimen/setting_row_height</item>
        <item name="android:singleLine">true</item>
        <item name="android:textDirection">5</item>
        <item name="android:layout_marginStart">@dimen/camera_setting_item_list_margin</item>
    </style>
    <style name="CameraSettingItemText" parent="">
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textColor">@color/tw_setting_item_text_color_normal</item>
        <item name="android:gravity">0x800015</item>
        <item name="android:layout_gravity">0x10</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:textDirection">5</item>
        <item name="android:layout_marginEnd">@dimen/camera_setting_item_list_margin</item>
    </style>
    <style name="SettingItemRestore" parent="">
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:textColor">@color/tw_setting_item_text_color_normal</item>
        <item name="android:ellipsize">4</item>
        <item name="android:gravity">0x11</item>
        <item name="android:layout_gravity">0x10</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">-2</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginStart">@dimen/camera_setting_item_list_margin</item>
        <item name="android:layout_marginEnd">@dimen/camera_setting_item_list_margin</item>
    </style>
    <style name="SettingItemList" parent="">
        <item name="android:scrollbarStyle">33554432</item>
        <item name="android:layout_gravity">0x11</item>
        <item name="android:orientation">1</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">-2</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="SettingContainer2" parent="">
        <item name="android:orientation">1</item>
        <item name="android:background">@drawable/tw_subsettings_background_material</item>
        <item name="android:paddingTop">@dimen/setting_container2_padding_top</item>
        <item name="android:paddingBottom">@dimen/setting_container2_padding_bottom</item>
        <item name="android:layout_width">@dimen/setting_container2_width</item>
        <item name="android:layout_height">-2</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:paddingStart">@dimen/setting_container2_padding_left</item>
        <item name="android:paddingEnd">@dimen/setting_container2_padding_right</item>
        <item name="android:layout_alignParentEnd">true</item>
    </style>
    <style name="SettingNewContainer2" parent="">
        <item name="android:orientation">1</item>
        <item name="android:background">@drawable/tw_subsettings_background_material</item>
        <item name="android:paddingTop">@dimen/setting_container2_padding_top</item>
        <item name="android:paddingBottom">@dimen/setting_container2_padding_bottom</item>
        <item name="android:layout_width">@dimen/setting_new_container2_width</item>
        <item name="android:layout_height">-2</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:paddingStart">@dimen/setting_container2_padding_left</item>
        <item name="android:paddingEnd">@dimen/setting_container2_padding_right</item>
        <item name="android:layout_alignParentEnd">true</item>
    </style>
    <style name="SettingVirtualTitle" parent="">
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textColor">@color/tw_setting_item_text_color_normal_text</item>
        <item name="android:ellipsize">4</item>
        <item name="android:gravity">0x1</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">-2</item>
        <item name="android:singleLine">true</item>
        <item name="android:textDirection">5</item>
    </style>
