        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:gravity">0x11</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
    </style>
    <style name="OnScreenInfoText" parent="">
        <item name="android:textAppearance">?android:attr/textAppearance</item>
        <item name="android:textColor">@color/setting_item_text_color_normal</item>
        <item name="android:gravity">0x11</item>
        <item name="android:layout_gravity">0x1</item>
        <item name="android:background">@drawable/bg_indicator_background</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="ItemListTitle" parent="">
        <item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
        <item name="android:textColor">@color/setting_item_text_color_highlight</item>
        <item name="android:ellipsize">4</item>
        <item name="android:gravity">0x800013</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">@dimen/setting_row_title_height</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginStart">@dimen/camera_setting_item_list_margin</item>
    </style>
    <style name="bottom_button" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">0x1</item>
        <item name="android:layout_gravity">0x800055</item>
        <item name="android:background">@drawable/cling_button_bg</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:layout_marginEnd">24dp</item>
    </style>
